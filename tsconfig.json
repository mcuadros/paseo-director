{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "connector/**/*.ts",
    "generated/**/*.ts",
    "rpc/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "tests/**/*.ts",
    "tools/smoke/**/*.ts"
  ]
}
