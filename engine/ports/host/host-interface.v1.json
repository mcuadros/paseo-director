{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcuadros/paseo-director/engine/ports/host/host-interface.v1.json",
  "schemaVersion": 1,
  "contractVersion": "director-host/v1",
  "credentialScope": "full-daemon-operator",
  "capabilities": [
    "executionWorkspace.createManaged",
    "executionWorkspace.observe",
    "executionWorkspace.archive",
    "taskAgent.createWithBootstrap",
    "reviewerAgent.createWithBootstrap",
    "send_agent_prompt",
    "helperAgent.observe",
    "agent.observe",
    "agent.archive"
  ],
  "boardQuery": {
    "name": "board.snapshot",
    "method": "GET",
    "path": "/v1/board",
    "schemaVersion": 1,
    "maximumTasks": 1000,
    "maximumBytes": 2097152,
    "states": [
      "needs_you",
      "queued",
      "building",
      "validating",
      "in_review",
      "ready"
    ]
  },
  "workerRegistry": {
    "schemaVersion": 1,
    "roles": ["task-agent", "reviewer"],
    "labels": {
      "project": "director.project",
      "rootWorkspace": "director.root-workspace",
      "workspace": "director.workspace",
      "executionWorkspace": "director.execution-workspace",
      "task": "director.task",
      "run": "director.run",
      "role": "director.role",
      "phase": "director.phase",
      "candidate": "director.candidate",
      "base": "director.base",
      "effect": "director.effect",
      "profile": "director.profile",
      "session": "director.session",
      "registeredAt": "director.registered-at",
      "startedAt": "director.started-at"
    }
  },
  "command": {
    "required": [
      "requestId",
      "idempotencyKey",
      "expectedVersion",
      "capability",
      "arguments"
    ],
    "optional": ["afterCursor"],
    "maximumBytes": 1048576,
    "arguments": {
      "required": ["scope", "effectKind", "effectId", "bindingHash"],
      "scopeRequired": ["projectId", "workspaceId", "taskId", "runId"],
      "effectKinds": [
        "host_view.create",
        "task_agent.create_with_bootstrap",
        "agent.send_prompt",
        "task_agent.archive",
        "host_view.archive"
      ],
      "optional": [
        "worktreeId",
        "worktreePath",
        "workspaceId",
        "agentId",
        "title",
        "initialPrompt",
        "parentAgentId",
        "lifecycleDigest",
        "isolationDigest",
        "preparationReady",
        "preparationBarrierHash",
        "notifyOnFinish",
        "clientMessageId",
        "boundaryId",
        "operationalObservationId",
        "profile",
        "session",
        "sessionBindingSha256",
        "labels"
      ]
    }
  },
  "observation": {
    "cursor": "uint64-monotonic",
    "required": [
      "requestId",
      "cursor",
      "observedAt",
      "result"
    ],
    "result": {
      "required": [
        "effectId",
        "status",
        "bindingHash",
        "priorDispatcherAbsent",
        "maximumAgeMillis",
        "factHash"
      ],
      "statuses": [
        "desired",
        "absent",
        "owned_present",
        "errored",
        "permission",
        "different",
        "ambiguous",
        "unavailable"
      ],
      "optional": ["externalId", "correlationHash"]
    }
  }
}
