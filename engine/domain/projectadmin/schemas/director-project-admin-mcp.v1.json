{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "contractVersion": "director.project-admin-mcp/v1",
  "supportedPaseoVersion": "0.7.2",
  "maximumRequestBytes": 65536,
  "maximumResponseBytes": 65536,
  "tools": [
    {
      "name": "director_admin_project_read",
      "description": "Read the bounded Project, Organizer, Workspace and configuration projection fixed to this session.",
      "mutating": false,
      "inputSchema": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    {
      "name": "director_admin_planning_read",
      "description": "Read the bounded Epic, Task, dependency and scheduling queue projection in this session Project.",
      "mutating": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": { "type": ["string", "null"], "maxLength": 5500 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    {
      "name": "director_admin_execution_read",
      "description": "Read bounded Runs, Workers and Reviews in this session Project after target membership checks.",
      "mutating": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view"],
        "properties": {
          "view": { "enum": ["runs", "workers", "reviews", "queue"] },
          "taskId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "runId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
        }
      }
    },
    {
      "name": "director_admin_planning_command",
      "description": "Submit one real Director planning command through current allowed-action, expected-version and reducer gates.",
      "mutating": true,
      "inputSchema": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "name"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "project.update" },
              "name": { "type": "string", "minLength": 1, "maxLength": 2048 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "key", "title", "description", "priority", "labels"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "epic.create" },
              "key": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "priority": { "type": ["string", "null"], "enum": ["urgent", "high", "normal", "low", null] },
              "labels": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "epicId", "title", "description", "priority", "labels"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "epic.update" },
              "epicId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "priority": { "type": ["string", "null"], "enum": ["urgent", "high", "normal", "low", null] },
              "labels": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "workspaceId", "epicId", "key", "title", "objective", "acceptanceCriteria", "priority", "labels"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "task.create" },
              "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "epicId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
              "key": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "objective": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
              "priority": { "enum": ["urgent", "high", "normal", "low"] },
              "labels": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "taskId", "epicId", "title", "objective", "acceptanceCriteria", "priority", "labels"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "task.update" },
              "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "epicId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "objective": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
              "priority": { "enum": ["urgent", "high", "normal", "low"] },
              "labels": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "taskId", "dependencyKind", "dependencyId"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "enum": ["dependency.add", "dependency.remove"] },
              "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "dependencyKind": { "enum": ["task", "epic"] },
              "dependencyId": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "taskId"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "task.launch-now" },
              "taskId": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        ]
      }
    },
    {
      "name": "director_admin_control_command",
      "description": "Submit one agent-authorized pause, resume, cancellation, or recovery request through current Director gates.",
      "mutating": true,
      "inputSchema": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "enum": ["project.pause", "project.resume"] }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "taskId", "runId"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "task.cancel" },
              "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "runId": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["requestId", "idempotencyKey", "expectedVersion", "type", "runId"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "expectedVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
              "type": { "const": "recovery.reconcile" },
              "runId": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        ]
      }
    },
    {
      "name": "director_admin_diagnostics_read",
      "description": "Read bounded redacted Project diagnostics and audit metadata without raw output, paths, credentials or storage access.",
      "mutating": false,
      "inputSchema": { "type": "object", "additionalProperties": false, "properties": {} }
    }
  ]
}
