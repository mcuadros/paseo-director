{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcuadros/paseo-director/engine/domain/agentoutcome/schemas/blocked_by_dependency.schema.json",
  "title": "BlockedByDependencyAgentOutcomeClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "dependencyIds", "wakePredicate"],
  "properties": {
    "outcome": { "const": "blocked_by_dependency" },
    "dependencyIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "wakePredicate": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
