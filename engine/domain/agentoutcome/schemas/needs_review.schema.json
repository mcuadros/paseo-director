{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcuadros/paseo-director/engine/domain/agentoutcome/schemas/needs_review.schema.json",
  "title": "NeedsReviewAgentOutcomeClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "candidateSha", "baseSha", "criterionIds"],
  "properties": {
    "outcome": { "const": "needs_review" },
    "candidateSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "baseSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "criterionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
